  vendorMargin   Float // e.g. 0.1 = 10%
}

model Notification {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  title         String?
  message       String?
  type          String?
  recipientId   String?
  recipientRole String?
  relatedId     String? // e.g. orderId, vendorId, etc.
  isRead        Boolean?  @default(false)
  createdAt     DateTime? @default(now())
  readAt        DateTime?
  metadata      Json?
}

enum NotificationCampaignStatus {
  draft
  scheduled
  sent
  failed
}

model PushToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  userId    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries NotificationDelivery[]
}

model NotificationCampaign {
  id              String                     @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  message         String
  target          String
  status          NotificationCampaignStatus @default(draft)
  scheduledAt     DateTime?
  sentAt          DateTime?
  recipientsCount Int                        @default(0)
  openRate        Float?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  deliveries NotificationDelivery[]
}

model NotificationDelivery {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  campaignId String   @db.ObjectId
  tokenId    String   @db.ObjectId
  status     String   @default("queued")
  error      String?
  sentAt     DateTime?
  openedAt   DateTime?
  createdAt  DateTime @default(now())

  campaign NotificationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  token    PushToken            @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([tokenId])
}

enum BlogStatus {
  draft
  scheduled
  published
}

model Blog {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  content         String
  excerpt         String
  slug            String     @unique
  metaDescription String?
  featuredImage   String?
  status          BlogStatus @default(draft)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  wordCount       Int        @default(0)
  aiGenerated     Boolean    @default(false)
  tags            String[]
  hashtags        String[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status, scheduledAt])
}
