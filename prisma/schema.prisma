model Discovery {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Display
  title       String // e.g., "Quick Meals"
  subtitle    String? // e.g., "Ready-to-eat noodles, pasta, soup mixes"
  image       String? // banner/card image
  displayType String // "grid" | "carousel" | "list" | "hero"

  // Linking
  moduleId String?
  type     String // "category" | "product" | "inventory" | "mixed"
  refIds   String[] @db.ObjectId // manual IDs (if curated)

  // Dynamic Filters
  filters Json? // JSON rules, e.g.
  /**
   * {
   * "price": { "lte": 100 },
   * "isFeatured": true,
   * "tags": ["healthy", "trending"],
   * "location": "Lucknow",
   * "sortBy": "popularity"
   * }
   */

  // Visual Settings
  theme       String? // "light" | "dark" | "custom"
  bgColor     String? // e.g., "#FFFFFF" or Tailwind token like "bg-gray-100"
  textColor   String? // e.g., "#000000" or "text-gray-800"
  accentColor String? // e.g., "#FF5733" for highlights
  layoutStyle String? // "card" | "banner" | "minimal" | "glassmorphism"
  customCss   String? // optional custom Tailwind classes

  // Control
  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)
  priority   Int? // ordering for homepage

  createdBy String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     DiscoveryItem[]
}

model DiscoveryItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Relation
  discoveryId String    @db.ObjectId
  discovery   Discovery @relation(fields: [discoveryId], references: [id], onDelete: Cascade)

  // Display
  title    String // e.g. "Instant Noodles"
  subtitle String? // optional
  image    String? // tile image / icon
  badge    String? // "NEW", "HOT", "10 MIN", etc

  theme       String? // "light" | "dark" | "custom"
  bgColor     String? // e.g., "#FFFFFF" or Tailwind token like "bg-gray-100"
  textColor   String? // e.g., "#000000" or "text-gray-800"
  accentColor String? // e.g., "#FF5733" for highlights
  layoutStyle String? // "card" | "banner" | "minimal" | "glassmorphism"
  customCss   String? // optional custom Tailwind classes

  // Navigation / Action
  targetType  String // "category" | "product" | "inventory" | "search" | "collection"
  targetIds   String[] @db.ObjectId // array of categoryIds / productIds / inventoryIds
  targetSlug  String? // for SEO / routing
  targetQuery Json? // for dynamic navigation
  /**
   * {
   * "category": "snacks",
   * "price": { "lte": 100 },
   * "tags": ["quick"]
   * }
   */

  // UI Behavior
  openMode String? // "push" | "modal" | "bottomSheet"
  deepLink String? // for app routing (future)

  // Ordering & State
  priority Int?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

